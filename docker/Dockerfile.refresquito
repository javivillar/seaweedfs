FROM golang:1.25-alpine AS builder
RUN apk add --no-cache git g++ fuse
WORKDIR /go/src/github.com/seaweedfs/seaweedfs
COPY . .
RUN cd weed && \
    export LDFLAGS="-X github.com/seaweedfs/seaweedfs/weed/util/version.COMMIT=$(git rev-parse --short HEAD || echo refresquito)" && \
    CGO_ENABLED=0 go build -ldflags "-extldflags -static ${LDFLAGS}" -o /go/bin/weed .

FROM alpine:3.23 AS final
LABEL author="Refresquito fork of seaweedfs/seaweedfs -- adds TrustedProxyAutoLogin (weed/admin/dash/auth_middleware.go)"
COPY --from=builder /go/bin/weed /usr/bin/
RUN mkdir -p /etc/seaweedfs
COPY docker/filer.toml /etc/seaweedfs/filer.toml
COPY docker/entrypoint.sh /entrypoint.sh

RUN apk upgrade --no-cache && \
    apk add --no-cache fuse curl su-exec libgcc libcrypto3 libssl3 && \
    addgroup -g 1000 seaweed && \
    adduser -D -u 1000 -G seaweed seaweed

# volume server gprc/http, filer server gprc/http, master server gprc/http, s3, webdav
EXPOSE 18080 8080 18888 8888 19333 9333 8333 7333

RUN mkdir -p /data/filerldb2 && \
    chown -R seaweed:seaweed /data && \
    chown -R seaweed:seaweed /etc/seaweedfs && \
    chmod 755 /entrypoint.sh

VOLUME /data
WORKDIR /data

ENTRYPOINT ["/entrypoint.sh"]
CMD ["mini", "-dir=/data"]
